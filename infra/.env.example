# ---- Core ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string

# ---- Database / cache ----
DATABASE_URL=postgresql+asyncpg://ad_user:ad_pass@localhost:5432/allergydetect
REDIS_URL=redis://localhost:6379/0

# Set to true only when a Celery worker is running (docker-compose does this).
# Leave false for local single-process dev; background jobs then run inline.
USE_CELERY=false

# ---- OpenAI (camera scanner + AI coach) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ---- Food databases ----
# Open Food Facts needs no key. These enable barcode/text fallbacks:
USDA_API_KEY=
NUTRITIONIX_APP_ID=
NUTRITIONIX_API_KEY=

# ---- Translation (travel allergy card) ----
GOOGLE_TRANSLATE_API_KEY=

# ---- Image storage (optional; falls back to local disk if unset) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
S3_BUCKET=

# ---- Push notifications (optional) ----
EXPO_ACCESS_TOKEN=
